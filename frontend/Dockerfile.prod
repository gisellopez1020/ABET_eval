# Instalación para usar la app (docker-compose.prod.yml): compila el frontend y lo sirve
# con nginx, que además hace de proxy de /api al backend. Para desarrollo, ver Dockerfile.
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=http://localhost:8000
ARG VITE_SKIP_AUTH=false
ENV VITE_API_URL=$VITE_API_URL \
    VITE_SKIP_AUTH=$VITE_SKIP_AUTH

RUN npm run build

FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
