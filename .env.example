# Base de datos
POSTGRES_USER=abet
POSTGRES_PASSWORD=abet_pass
POSTGRES_DB=abet_eval

# Google OAuth 2.0 (reemplazar con valores reales del proyecto en Google Cloud Console)
GOOGLE_CLIENT_ID=PLACEHOLDER
GOOGLE_CLIENT_SECRET=PLACEHOLDER
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# JWT propio de la app. Obligatoria con SKIP_AUTH=false (mínimo 32 caracteres):
# el backend no arranca con PLACEHOLDER. Ver SETUP_GOOGLE.md, paso 4.
JWT_SECRET_KEY=PLACEHOLDER

# URL del frontend a la que se redirige tras completar el login con Google
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos por CORS, separados por comas. No se permite "*" (la sesión
# viaja en una cookie): el backend no arranca con "*" o con la lista vacía.
FRONTEND_ORIGINS=http://localhost:5173,http://frontend:5173

# Google Drive
GOOGLE_DRIVE_FOLDER_NAME=ABET_Eval

# Desarrollo: omite el login real con Google (todos entran como un usuario simulado).
# Solo para localhost: con SKIP_AUTH=true el backend no arranca si GOOGLE_REDIRECT_URI,
# FRONTEND_URL o FRONTEND_ORIGINS apuntan a un dominio real. En un despliegue, SKIP_AUTH=false.
SKIP_AUTH=true

# Retroalimentación redactada con IA (Gemini, https://aistudio.google.com/apikey).
# Con PLACEHOLDER no se llama a la API: se muestra la retroalimentación estructurada
# (criterios cumplidos / por reforzar). No es un error.
GEMINI_API_KEY=PLACEHOLDER
# Modelo y nivel de razonamiento: confirmar con ListModels que el modelo está disponible
# para la key; el nivel depende del modelo (gemini-3.8-flash acepta "low", no "minimal")
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# Frontend
VITE_API_URL=http://localhost:8000
VITE_SKIP_AUTH=true
