# Base de datos
POSTGRES_USER=abet
POSTGRES_PASSWORD=abet_pass
POSTGRES_DB=abet_eval

# Google OAuth 2.0 (reemplazar con valores reales del proyecto en Google Cloud Console)
GOOGLE_CLIENT_ID=PLACEHOLDER
GOOGLE_CLIENT_SECRET=PLACEHOLDER
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# JWT propio de la app
JWT_SECRET_KEY=PLACEHOLDER

# URL del frontend a la que se redirige tras completar el login con Google
FRONTEND_URL=http://localhost:5173

# Google Drive
GOOGLE_DRIVE_FOLDER_NAME=ABET_Eval

# Desarrollo: omite el login real con Google
SKIP_AUTH=true

# Frontend
VITE_API_URL=http://localhost:8000
VITE_SKIP_AUTH=true
