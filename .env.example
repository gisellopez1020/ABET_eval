# Base de datos
POSTGRES_USER=abet
POSTGRES_PASSWORD=abet_pass
POSTGRES_DB=abet_eval

# Google OAuth 2.0 (reemplazar con valores reales del proyecto en Google Cloud Console)
GOOGLE_CLIENT_ID=PLACEHOLDER
GOOGLE_CLIENT_SECRET=PLACEHOLDER
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# JWT propio de la app. Obligatoria con SKIP_AUTH=false (mínimo 32 caracteres):
# el backend no arranca con PLACEHOLDER. Ver SETUP_GOOGLE.md, paso 4.
JWT_SECRET_KEY=PLACEHOLDER

# Clave con que se cifra en la base de datos el acceso a Google Drive de cada docente,
# para que no haya que volver a iniciar sesión tras reiniciar. Obligatoria con
# SKIP_AUTH=false: el backend no arranca con PLACEHOLDER. Ver SETUP_GOOGLE.md, paso 5.
TOKEN_ENCRYPTION_KEY=PLACEHOLDER

# Clave con que se cifran en la base de datos el nombre, el código y el correo de cada
# estudiante (RNF-14). Distinta de las dos anteriores. Obligatoria con SKIP_AUTH=false:
# el backend no arranca con PLACEHOLDER. Con SKIP_AUTH=true es opcional: sin ella esos
# datos se guardan SIN CIFRAR (se avisa al arrancar). Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡GUÁRDALA FUERA DEL SERVIDOR! Si se pierde o cambia, los datos de los estudiantes NO
# se pueden recuperar, ni siquiera desde un respaldo. Ver DESPLIEGUE_PRODUCCION.md.
DATA_ENCRYPTION_KEY=PLACEHOLDER

# URL del frontend a la que se redirige tras completar el login con Google
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos por CORS, separados por comas. No se permite "*" (la sesión
# viaja en una cookie): el backend no arranca con "*" o con la lista vacía.
FRONTEND_ORIGINS=http://localhost:5173,http://frontend:5173

# Google Drive
GOOGLE_DRIVE_FOLDER_NAME=ABET_Eval

# Swagger (/docs, /redoc, /openapi.json). docker-compose.https.yml y
# docker-compose.detras-de-proxy.yml lo apagan (detrás del prefijo /api no carga).
API_DOCS=true

# Con SKIP_AUTH=false, GOOGLE_REDIRECT_URI, FRONTEND_URL y FRONTEND_ORIGINS deben ser
# https:// salvo localhost, 127.0.0.1, ::1 y el servicio "frontend": el backend no
# arranca con http://dominio. Producción con HTTPS: ver DESPLIEGUE_PRODUCCION.md.

# Desarrollo: omite el login real con Google (todos entran como un usuario simulado).
# Solo para localhost: con SKIP_AUTH=true el backend no arranca si GOOGLE_REDIRECT_URI,
# FRONTEND_URL o FRONTEND_ORIGINS apuntan a un dominio real. En un despliegue, SKIP_AUTH=false.
SKIP_AUTH=true

# Retroalimentación redactada con IA (Gemini, https://aistudio.google.com/apikey).
# Con PLACEHOLDER no se llama a la API: se muestra la retroalimentación estructurada
# (criterios cumplidos / por reforzar). No es un error.
GEMINI_API_KEY=PLACEHOLDER
# Modelo y nivel de razonamiento: confirmar con ListModels que el modelo está disponible
# para la key; el nivel depende del modelo (gemini-3.8-flash acepta "low", no "minimal")
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# Frontend
VITE_API_URL=http://localhost:8000
VITE_SKIP_AUTH=true

# ── Solo para producción con HTTPS (DESPLIEGUE_PRODUCCION.md) ─────────────────
# Úsalas en un archivo aparte (p. ej. .env.produccion, ignorado por git), no aquí.
# Red interna de Docker y la IP fija de nginx en ella (la única de la que el backend
# acepta X-Forwarded-For/-Proto). Cambiarlas solo si chocan con una red de la universidad.
# RED_INTERNA_SUBNET=172.30.80.0/24
# NGINX_IP=172.30.80.10
# Variante A (docker-compose.https.yml): puertos de nginx
# PUERTO_HTTP=80
# PUERTO_HTTPS=443
# Variante B (docker-compose.detras-de-proxy.yml): IP o red del proxy de la
# universidad (la única que puede conectarse) y puerto en que escucha nginx
# PROXY_CONFIANZA=10.0.0.5
# PUERTO_PROXY=8080
